# Copia este archivo como .env y completa los valores de tu proyecto de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK).
#
# Si lo dejas vacío, la tienda funciona en "modo demo": productos de ejemplo
# guardados en el navegador y un botón para entrar como administrador.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_SENDER_ID=
VITE_APP_ID=

# Pon "true" solo si tu proyecto está en el plan Blaze y activaste Cloud Storage.
# Si no, el administrador pega el enlace de las fotos en lugar de subirlas.
VITE_USE_STORAGE=false
